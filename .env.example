# Hugging Face access token — required for authenticated Hub downloads
# (higher rate limits) and IDM-VTON / CatVTON Spaces.
# 1. Create a token: https://huggingface.co/settings/tokens (Read is enough)
# 2. Paste it below, save this file as .env, then restart Streamlit.
# This is NOT an LLM/OpenAI key — vision/diffusion only.
HF_TOKEN=

# Optional Gemini stylist / garment captions (template fallback if unset)
GOOGLE_API_KEY=

# Optional overrides
# HF_INPAINT_MODEL=stabilityai/stable-diffusion-2-inpainting
# VTON_SPACE=yisol/IDM-VTON
# CATVTON_SPACE=zhengchong/CatVTON
# GEMINI_MODEL=gemini-2.0-flash
# CONFIDENCE_GATE=0.85
